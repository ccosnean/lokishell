#!/usr/bin/env python3
"""Start LokiShell from a checkout or a Homebrew installation."""
from pathlib import Path
import sys

package_root = Path(__file__).resolve().parents[1]
library = package_root / 'lib'
if not (library / 'lokishell').is_dir():
    library = package_root / 'libexec/lib'
sys.path.insert(0, str(library))
from lokishell.cli import entrypoint

if __name__ == '__main__':
    entrypoint()
